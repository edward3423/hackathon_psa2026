# Create an API key at https://aistudio.google.com/app/apikey for the later live path.
GEMINI_API_KEY=

# Server-only AISStream key. The browser never receives this value.
AISSTREAM_API_KEY=
# Public Mapbox token. Restrict it to the deployed site URL in Mapbox.
VITE_MAPBOX_ACCESS_TOKEN=
# Optional AISStream latitude/longitude boxes. Defaults to Red Sea and Singapore.
# AISSTREAM_BOUNDING_BOXES_JSON=[[[10,30],[30,45]],[[-2,100],[8,108]]]

